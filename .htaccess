Options -Indexes
DirectoryIndex index.php index.html
RewriteEngine On

# Preserve the existing canonical host and HTTPS redirects.
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^www\.toolboxkart\.tech$ [NC]
RewriteRule ^ https://toolboxkart.tech%{REQUEST_URI} [R=301,L,NE]

# Serve the fresh site's dynamic crawler files.
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^robots\.txt$ robots.php [L]

# Preserve legacy public URL redirects.
RewriteRule ^finance/systematic-investment-plan-calculater/?$ /finance/systematic-investment-plan-calculator/ [R=301,L,NE]
RewriteRule ^image-tools/bulk-Image-resizer-tool/?$ /image-tools/bulk-image-resizer-tool/ [R=301,L,NE,NC]
RewriteRule ^post(?:/(.*))?$ /seo-guide/$1 [R=301,L,NE]

ErrorDocument 404 /404.php

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Keep internal fresh-site implementation files out of public routes.
RewriteRule ^(?:docs|tests|registry|includes|partials)/ - [F,L]
<FilesMatch "^(?:config\.php|tool\.php|form\.php|README\.md|AGENTS\.md|TEST-REPORT\.md)$">
	Require all denied
</FilesMatch>
