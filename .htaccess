Options -Indexes
DirectoryIndex index.php
ErrorDocument 404 /404.php
RewriteEngine On

# Serve the sitemap dynamically from the current posts/tools index.
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Canonical HTTPS + host. Uncomment after DNS and SSL are confirmed if Hostinger is not already enforcing HTTPS.
# RewriteCond %{HTTPS} !=on [OR]
# RewriteCond %{HTTP_HOST} !^toolboxkart\.tech$ [NC]
# RewriteRule ^ https://toolboxkart.tech%{REQUEST_URI} [R=301,L,NE]

# Do not expose implementation and project documentation directories.
RewriteRule ^(?:includes|data|docs)(?:/|$) - [F,L,NC]

# Canonicalize index.php to its directory URL, including the site root.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.php[\s?] [NC]
RewriteRule ^(.*/)?index\.php$ /$1 [R=301,L,NE]

# Redirect old blog and category article URLs to the new category-based URL structure.
RewriteRule ^blog/australian-youth-safety-blueprint-six-pillars/?$ /ai-news/openai-safety-blueprint-australia-2026 [R=301,L,NE]

RewriteRule ^ai-news/australian-youth-safety-blueprint-six-pillars/?$ /ai-news/openai-safety-blueprint-australia-2026 [R=301,L,NE]

RewriteRule ^blog/?$ /chatgpt/ [R=301,L]
RewriteRule ^blog/(.+)$ /blog-redirect.php?slug=$1 [L,QSA]
RewriteRule ^(chatgpt|claude|ai-news|tools-guide)/(.+)$ /category-article.php?category=$1&slug=$2 [L,QSA]

# Send catalog-defined category indexes through the shared dynamic category template.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)/?$ router.php [L,QSA]

# Redirect browser requests for other .php pages to extensionless canonical URLs.
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^(.+)\.php$ /$1 [R=301,L,NE]

# Extensionless files: /seo/serp-preview -> /seo/serp-preview.php internally.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# The blog index is dynamic and must never be served as a stale page-cache copy.
# The PHP page also sends matching no-cache headers as a runtime safeguard.
SetEnvIf Request_URI "^/blog/?$" TOOLBOXKART_BLOG_NOCACHE

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0" env=TOOLBOXKART_BLOG_NOCACHE
  Header always set Pragma "no-cache" env=TOOLBOXKART_BLOG_NOCACHE
  Header always set Expires "0" env=TOOLBOXKART_BLOG_NOCACHE
  Header always set X-LiteSpeed-Cache-Control "no-cache" env=TOOLBOXKART_BLOG_NOCACHE
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
</IfModule>
