      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is n8n free?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Community Edition is available for self-hosting, but the licence applies and infrastructure still costs money. n8n Cloud offers a trial, not a permanent free Cloud plan."
          }
        },
        {
          "@type": "Question",
          "name": "Is n8n open source?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "n8n publishes source under the Sustainable Use License. It is not an OSI-approved open-source licence, so review the exact terms for your use."
          }
        },
        {
          "@type": "Question",
          "name": "Does n8n charge for every workflow step?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. n8n Cloud counts a full workflow run as one execution, regardless of the number of steps."
          }
        },
        {
          "@type": "Question",
          "name": "Is n8n 3.0 ready for production?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The documentation lists n8n 3.0 as an early-access release. Review the breaking changes and migration report before upgrading production."
          }
        }
